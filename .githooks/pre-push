#!/bin/sh
# Verify, never rewrite: each commit about to be pushed must carry a current attestation (ADR 0006).
# The pre-commit hook writes it. After a rebase, merge or cherry-pick run `make attest` and commit.
set -eu
cd "$(git rev-parse --show-toplevel)"
py="${HFTLAB_PYTHON:-}"
if [ -z "$py" ]; then
    if [ -x .venv/bin/python ]; then py=.venv/bin/python; else py=python3; fi
fi
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ "$local_sha" = "$zero" ] && continue   # a deleted ref pushes no content
    "$py" tools/leakcheck.py --verify-attest --rev "$local_sha" || status=1
done
exit "$status"
