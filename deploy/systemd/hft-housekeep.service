[Unit]
Description=HFT Lab housekeep: compress the closed hours of the recording and hand old ones to the offload, then compress the closed parts of the trader's tapes
Documentation=file:///home/hft/hft-lab/docs/runbooks/README.md

[Service]
Type=oneshot
User=hft
Group=hft
Slice=hft.slice
WorkingDirectory=/home/hft/hft-lab
Environment=MODE=paper
Environment=PYTHONPATH=src
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=UTC
Environment=HFT_STATE_DIR=/home/hft/hft-lab/var
ExecStart=/home/hft/hft-lab/.venv/bin/python -m hftlab.record --housekeep
ExecStartPost=-/home/hft/hft-lab/.venv/bin/python -m hftlab.trader --housekeep
TimeoutStartSec=1800
Nice=15
IOSchedulingClass=idle
MemoryMax=200M
OOMScoreAdjust=500
ReadWritePaths=/home/hft/hft-lab/var
InaccessiblePaths=-/home/wt
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
